# Public Supabase runtime configuration. Use the tgn-services project values.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Server-only database access. Never expose this as a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Direct Postgres connection used only by Drizzle migrations.
SUPABASE_DB_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres

# Server-only cron authentication for a future protected outbox retry job.
CRON_SECRET=<random-secret>
CRON_SECRET_PREVIOUS=

# Used when PR #3 email notifications are enabled.
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM=TGN Services <noreply@example.invalid>
CONTACT_EMAIL=<company-contact-email>
BOOKING_EMAIL=
SERVICE_START_EMAIL=
